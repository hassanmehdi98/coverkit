# Copy to .env.production on the server, chmod 600, never commit.
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.production

# Public hostname (no scheme) — used by Caddy for Let's Encrypt
DOMAIN=coverkit.dev

# App URLs (HTTPS)
APP_URL=https://coverkit.dev
AUTH_URL=https://coverkit.dev

# Postgres (compose service name is `db` — not exposed on the host)
POSTGRES_USER=coverkit
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=coverkit
DATABASE_URL=postgresql://coverkit:change-me-to-a-long-random-string@db:5432/coverkit?schema=public

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# S3 (instance role credentials — do NOT set access keys on the box)
S3_BUCKET=coverkit-uploads
S3_REGION=us-east-1
# Leave S3_ENDPOINT unset in production
S3_PUBLIC_BASE_URL=https://coverkit-uploads.s3.us-east-1.amazonaws.com

# Landing footer
NEXT_PUBLIC_CONTACT_EMAIL=hello@coverkit.dev
NEXT_PUBLIC_TWITTER_URL=https://x.com/coverkit

# Sentry error monitoring (optional but recommended for launch)
# Same DSN for both; omit to disable. NEXT_PUBLIC_* is inlined at Docker build time.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional source-map upload during image build (omit to skip — build still succeeds)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
