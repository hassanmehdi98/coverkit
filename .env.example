# App
APP_URL="http://localhost:3000"

# Database (Docker Compose Postgres)
DATABASE_URL="postgresql://coverkit:coverkit@localhost:5433/coverkit?schema=public"

# Auth.js (Google OAuth) — required for Phase 2 sign-in
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Optional; defaults from request host when trustHost is enabled
AUTH_URL="http://localhost:3000"

# S3 / MinIO
# Local MinIO (docker compose): use the minioadmin keys below AND set S3_ENDPOINT.
# Production AWS: leave S3_ENDPOINT unset and use the EC2 instance role (no access keys).
S3_BUCKET="coverkit-uploads"
S3_REGION="us-east-1"
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_BASE_URL="http://localhost:9000/coverkit-uploads"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# Landing footer
NEXT_PUBLIC_CONTACT_EMAIL="hello@coverkit.dev"
NEXT_PUBLIC_TWITTER_URL="https://x.com/coverkit"

# Sentry (optional — omit locally; SDK is a no-op without a DSN)
# Server uses SENTRY_DSN; client/global-error uses NEXT_PUBLIC_SENTRY_DSN (same value is fine).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: enable source-map upload during `next build` (skip if unset)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
